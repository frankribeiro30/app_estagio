datasource db {
  provider = "postgresql"
}
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique
}

model Pessoa {
  id String @id @default(uuid())
  nome String
  cpf String @unique
}